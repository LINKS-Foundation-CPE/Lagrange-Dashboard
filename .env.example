# All configuration is baked in at BUILD time: changing any of these means
# rebuilding (`npm run build`), not restarting.

# quantum-api REST base URL, including the /api mount.
VITE_API_URL=https://api.example.org/api
# Token-exchange endpoint: swaps the OIDC access token for the platform token
# that every /api/* call carries.
VITE_TOKEN_URL=https://api.example.org/auth/token

# Identity provider. VITE_KEYCLOAK_URL is the base URL including whatever
# relative path the provider is served under (Keycloak's KC_HTTP_RELATIVE_PATH,
# commonly /auth).
VITE_KEYCLOAK_URL=https://idp.example.org/auth
VITE_KEYCLOAK_REALM=cortex
# Public client with the authorization-code flow enabled and this dashboard's
# origin in its redirect URIs and web origins.
VITE_KEYCLOAK_CLIENTID=dashboard

# Note: quantum-api's CORS_ORIGIN must match the origin this build is served
# from, exactly — scheme, host and port. A mismatch produces a dashboard that
# loads and then fails every API call.

# Sibling pages embedded as read-only panels in the left sidebar. Each is shown
# only when its URL is set, so a deployment without a monitoring stack simply
# does not have the panel. They are framed cross-origin, so whatever serves them
# must not send `X-Frame-Options`, and any `Content-Security-Policy:
# frame-ancestors` it does send must name this dashboard's origin.
#VITE_MACHINE_STATUS_URL=https://status.example.org/
#VITE_MACHINE_METRICS_URL=https://overview.example.org/
# Which monitors the status panel shows, as `tag` or `tag:Label`, comma
# separated — the tags configured in the Kener instance above. Spaces are fine
# and must NOT be quoted: Vite parses this file with dotenv, which takes the
# whole line, and a GitLab UI variable would keep the quote characters. A `#`
# starts a comment, and a comma always separates monitors; a colon inside a
# label is safe (only the first one splits). Unset shows Kener's `_`
# pseudo-monitor, which aggregates every active monitor.
#VITE_MACHINE_STATUS_MONITORS=frontend:Frontend API,backend:Backend DB API

# User documentation. A sidebar link that opens in a new tab, not a panel: it is
# a separate site with its own navigation. Hidden when unset.
#VITE_DOCS_URL=https://docs.example.org/
